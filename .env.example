# mock = no network, no key (default).  real = calls Groq.
INFERENCE_MODE=mock
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# mock = simple word-matching vectors, works offline.  fastembed = real embedding model.
EMBEDDING_MODE=mock
EMBEDDING_MODEL=mpnet

# Below this similarity the app refuses to answer (you choose it in stage 5).
SEARCH_THRESHOLD=0.20
